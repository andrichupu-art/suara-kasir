# ============================================================
# SuaraKasir — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# ============================================================

# Database PostgreSQL - dari Supabase
# Ambil dari: Supabase Dashboard → Project → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[password]@[host].supabase.co:5432/postgres

# Secret untuk JWT session (wajib, isi string acak panjang)
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Node environment
NODE_ENV=production
